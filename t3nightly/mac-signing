#!/usr/bin/env bash
set -euo pipefail

if [ "${1:-}" = --help ]; then
  echo "usage: mac-signing DIR (prepare a temporary signing keychain; call mac-signing-done DIR after building)"
  exit 0
fi
here="$(cd "$(dirname "$0")" && pwd)"
dir="${1:?usage: mac-signing DIR}"
mkdir -p "$dir"
chmod 700 "$dir"
keychain="$dir/t3nightly-signing.keychain-db"
password="$(/usr/bin/openssl rand -hex 16)"
lock="$HOME/.t3nightly/mac-signing.lock"
mkdir -p "$(dirname "$lock")"
deadline=$((SECONDS + ${T3NIGHTLY_SIGNING_WAIT_S:-900}))
until mkdir "$lock" 2>/dev/null; do
  if [ "$SECONDS" -ge "$deadline" ]; then
    echo "mac-signing refusal: another signing job held the lock past the wait ($(cat "$lock/owner" 2>/dev/null))" >&2
    exit 4
  fi
  sleep 2
done
printf '%s\n' "$dir" > "$lock/owner"
cleanup() {
  "$here/mac-signing-done" "$dir"
}
trap cleanup EXIT
agent-secret get gh-agent-rails-csc-link | base64 --decode > "$dir/cert.p12"
security create-keychain -p "$password" "$keychain" >/dev/null
security set-keychain-settings -lut 21600 "$keychain"
security unlock-keychain -p "$password" "$keychain"
/usr/bin/openssl pkcs12 -in "$dir/cert.p12" -passin fd:3 -nodes -out "$dir/cert.pem" 3< <(agent-secret get gh-agent-rails-csc-key-password)
security import "$dir/cert.pem" -k "$keychain" -T /usr/bin/codesign >/dev/null
rm -f "$dir/cert.p12" "$dir/cert.pem"
security set-key-partition-list -S apple-tool:,apple: -s -k "$password" "$keychain" >/dev/null
existing="$(security list-keychains -d user | tr -d '"' | tr '\n' ' ')"
security list-keychains -d user -s "$keychain" $existing
identity="$(security find-identity -v -p codesigning "$keychain" | sed -n 's/.*"\(Developer ID Application: [^"]*\)".*/\1/p' | head -n 1)"
[ -n "$identity" ] || { echo "no Developer ID Application identity in the signing cert" >&2; exit 3; }
agent-secret get gh-agent-rails-apple-api-key-p8 > "$dir/AuthKey.p8"
chmod 600 "$dir/AuthKey.p8"
printf 'T3NIGHTLY_KEYCHAIN=%q\n' "$keychain"
printf 'T3CODE_CLI_MAC_SIGN_IDENTITY=%q\n' "$identity"
printf 'CSC_NAME=%q\n' "${identity#Developer ID Application: }"
printf 'CSC_KEYCHAIN=%q\n' "$keychain"
printf 'APPLE_API_KEY=%q\n' "$dir/AuthKey.p8"
api_id="$(agent-secret get gh-agent-rails-apple-api-key-id)"
issuer="$(agent-secret get gh-agent-rails-apple-api-issuer)"
team="$(agent-secret get gh-agent-rails-apple-team-id)"
[ -n "$api_id" ] && [ -n "$issuer" ] && [ "$team" = 89X6B853KW ] || exit 3
printf 'APPLE_API_KEY_ID=%q\n' "$api_id"
printf 'APPLE_API_ISSUER=%q\n' "$issuer"
printf 'APPLE_TEAM_ID=%q\n' "$team"
trap - EXIT
