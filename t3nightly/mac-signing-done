#!/usr/bin/env bash
set -euo pipefail

if [ "${1:-}" = --help ]; then
  echo "usage: mac-signing-done DIR (delete the temporary signing keychain and release its lock)"
  exit 0
fi
dir="${1:?usage: mac-signing-done DIR}"
keychain="$dir/t3nightly-signing.keychain-db"
lock="$HOME/.t3nightly/mac-signing.lock"
cleanup() {
  if [ -f "$keychain" ]; then
    security delete-keychain "$keychain" || true
  fi
  rm -rf "$dir"
  if [ -f "$lock/owner" ] && [ "$(cat "$lock/owner")" = "$dir" ]; then
    rm -f "$lock/owner"
    rmdir "$lock"
  fi
}
trap cleanup EXIT
status=0
"$(cd "$(dirname "$0")" && pwd)/keychain-search" remove "$keychain" || status=$?
[ "$status" -eq 0 ] || [ "$status" -eq 3 ] || exit "$status"
