#!/usr/bin/env python3
import argparse
import json
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from t3nightly.install_policy import window


def main():
    parser = argparse.ArgumentParser(description="Gate an other-host/Book/Windows live install before dispatch. Pass the installer command after --.")
    parser.add_argument("--host", required=True)
    parser.add_argument("--version", required=True)
    parser.add_argument("--override-reason", default="")
    parser.add_argument("--receipt", type=Path, required=True)
    parser.add_argument("command", nargs=argparse.REMAINDER)
    args = parser.parse_args()
    command = args.command[1:] if args.command[:1] == ["--"] else args.command
    try:
        policy = window(args.version, reason=args.override_reason, host=args.host)
    except ValueError as error:
        args.receipt.parent.mkdir(parents=True, exist_ok=True)
        args.receipt.write_text(json.dumps({"allowed": False, "host": args.host, "version": args.version, "error": str(error)}) + "\n")
        parser.exit(1, f"install-window refusal: {error}\n")
    args.receipt.parent.mkdir(parents=True, exist_ok=True)
    args.receipt.write_text(json.dumps({"installWindow": policy, "outcome": "admitted"}) + "\n")
    code = subprocess.run(command, check=False).returncode if command else 0
    args.receipt.write_text(json.dumps({"installWindow": policy, "commandExit": code, "outcome": "passed" if code == 0 else "failed"}) + "\n")
    return code


if __name__ == "__main__":
    raise SystemExit(main())
