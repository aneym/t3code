#!/usr/bin/env python3
import argparse
import json
import subprocess
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from t3nightly.install_run import Failure, Run
from t3nightly.install_preflight import checked_assets
from t3nightly.install_assets import serve_assets
from t3nightly.install_payload_gc import payload_lifecycle

from t3nightly.install_policy import DEFAULT_DRAIN_S

FORK_BASE_URL = "https://github.com/aneym/t3code/releases/download"

def parse():
    parser = argparse.ArgumentParser(prog="t3nightly-install")
    parser.add_argument("--version", default="")
    parser.add_argument("--calibrate", action="store_true")
    parser.add_argument("--home", default="~/.t3")
    parser.add_argument("--port", type=int, default=3773)
    parser.add_argument("--base-url", default=FORK_BASE_URL)
    parser.add_argument("--assets", default="")
    parser.add_argument("--verdict", default="")
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("--state-dir", default="~/.t3nightly")
    parser.add_argument("--service-label", default="com.t3tools.t3code.service")
    parser.add_argument("--service-plist", default="")
    parser.add_argument("--service-env", default="~/.t3/service.env")
    parser.add_argument(
        "--systemd-dropin", default="~/.config/systemd/user/t3code.service.d"
    )
    parser.add_argument("--backups", default="~/.t3nightly/backups")
    parser.add_argument("--backup-keep", type=int, default=2)
    parser.add_argument("--load-max", type=float, default=1.5)
    parser.add_argument("--merge-repo", default="")
    parser.add_argument("--merge-fresh-s", type=int, default=2700)
    parser.add_argument("--lock", action="append", default=[])
    parser.add_argument("--ignore-thread", action="append", default=[])
    parser.add_argument("--wait", action="store_true")
    parser.add_argument("--until", default="")
    parser.add_argument("--recheck-s", type=int, default=600)
    parser.add_argument("--health-s", type=int, default=300)
    parser.add_argument("--settle-s", type=int, default=60)
    parser.add_argument("--allow-downgrade", action="store_true")
    parser.add_argument("--check-only", action="store_true")
    parser.add_argument("--smoke-verdict")
    parser.add_argument("--rollback-proof")
    parser.add_argument("--snapshot-mib-s", type=float, default=32)
    parser.add_argument("--snapshot-max-s", type=int, default=1200)
    parser.add_argument("--prepare-only", action="store_true")
    parser.add_argument("--seamless", action="store_true")
    parser.add_argument("--override-reason", default="")
    parser.add_argument("--connector-artifact", default="")
    parser.add_argument("--launcher-artifact", default="")
    parser.add_argument("--live-home", action="append", default=[])
    parser.add_argument("--restart-probe", action="store_true")
    parser.add_argument("--drain-proof", action="store_true")
    parser.add_argument("--hard", action="store_true")
    parser.add_argument("--receipt", default="")
    parser.add_argument("--manifest", default="")
    parser.add_argument("--artifact-manifest", default="")
    parser.add_argument("--install-receipt", default="")
    parser.add_argument("--receipt-host", choices=("studio", "ax42", "forge", "owl"))
    parser.add_argument("--rehearsal", action="store_true")
    parser.add_argument("--strict-drain-proof", action="store_true")
    parser.add_argument("--rehearsal-inject", dest="inject", choices=("none", "warm-death", "post-flip"), default="none")
    parser.add_argument("--rollback-fallback-proof", action="store_true", help="isolated non-release fallback proof; never changes existing injection semantics")
    parser.add_argument("--compatibility-probe", action="store_true")
    parser.add_argument("--force-rollback", action="store_true")
    parser.add_argument("--chat-project", default="")
    parser.add_argument("--chat-provider", default="claudeAgent")
    parser.add_argument("--chat-model", default="claude-sonnet-4-6")
    parser.add_argument("--chat-timeout", type=int, default=90)
    parser.add_argument("--rpc-tree", default="")
    parser.add_argument("--drain-s", type=int, default=DEFAULT_DRAIN_S)
    parser.add_argument("--node", default="node")
    parser.add_argument("--no-pin-launcher", action="store_true")
    parser.add_argument("--offbox", default="")
    parser.add_argument("--offbox-mib-s", type=float, default=0.5)
    parser.add_argument("--offbox-seed-s", type=int, default=43200)
    parser.add_argument("--offbox-stop-s", type=int, default=600)
    parser.add_argument("--offbox-stage", default="")
    parser.add_argument("--offbox-stage-floor-gib", type=int, default=60)
    parser.add_argument("--offbox-copy-s", type=int, default=600)
    parser.add_argument("--offbox-window-s", type=int, default=0, help="whole window from installer start; stopped ship refuses before the stop unless the forward path plus a rollback fits")
    parser.add_argument("--offbox-stopped-ship", action="store_true", help="seed from a verified off-box replica and sync only the stopped database; no live stage copy or local restore copy")
    args = parser.parse_args()
    if not args.version and not args.calibrate:
        parser.error("--version is required unless --calibrate")
    if args.calibrate and any((args.hard, args.seamless, args.prepare_only, args.rehearsal, args.version, args.wait, args.check_only, args.dry_run)):
        parser.error("--calibrate cannot be combined with installation modes, --version, --wait, --check-only or --dry-run")
    if args.backup_keep < 1:
        parser.error("--backup-keep must be at least one")
    if not 0 <= args.drain_s <= 300:
        parser.error("--drain-s must be between 0 and 300")
    if args.hard and (args.seamless or args.wait or args.check_only or args.prepare_only):
        parser.error("--hard cannot be combined with --seamless, --wait, --check-only or --prepare-only")
    if args.hard and (not args.manifest or not args.artifact_manifest or not args.chat_project or (not args.receipt and not args.rehearsal)):
        parser.error("--hard requires --manifest, --artifact-manifest, --chat-project and --receipt (or isolated --rehearsal)")
    if args.rehearsal and not (args.hard or args.seamless):
        parser.error("--rehearsal requires --hard or --seamless")
    if (args.inject != "none" or args.rollback_fallback_proof) and not (args.rehearsal and args.seamless):
        parser.error("fault and fallback proofs require isolated --rehearsal --seamless")
    if args.rollback_fallback_proof and (args.inject != "none" or args.force_rollback):
        parser.error("--rollback-fallback-proof cannot replace an existing rollback proof")
    if args.strict_drain_proof and not args.rehearsal:
        parser.error("--strict-drain-proof requires isolated --rehearsal")
    if args.force_rollback and not args.rehearsal:
        parser.error("--force-rollback requires isolated --rehearsal")
    if args.compatibility_probe and not args.rehearsal:
        parser.error("--compatibility-probe requires isolated --rehearsal")
    if args.seamless and not all((args.manifest, args.artifact_manifest, args.chat_project, args.rpc_tree, args.receipt or args.rehearsal)):
        parser.error("--seamless requires --manifest, --artifact-manifest, --chat-project, --rpc-tree and --receipt (or --rehearsal)")
    if args.offbox:
        if not (args.hard or args.seamless):
            parser.error("--offbox requires --hard or --seamless")
        if args.offbox_mib_s <= 0 or args.offbox_seed_s < 60 or args.offbox_stop_s < 30:
            parser.error("--offbox-mib-s must be positive, --offbox-seed-s at least 60 and --offbox-stop-s at least 30")
        if not (args.offbox_stage or args.offbox_stopped_ship) or args.offbox_stage_floor_gib < 0 or args.offbox_copy_s < 10:
            parser.error("--offbox requires --offbox-stage, a non-negative --offbox-stage-floor-gib and --offbox-copy-s of at least 10")
        from t3nightly.install_offbox import target

        try:
            target(args.offbox)
        except ValueError as error:
            parser.error(str(error))
    return args


if __name__ == "__main__":
    started_monotonic = time.monotonic()
    args = parse()
    args.started_monotonic = started_monotonic
    try:
        if args.calibrate:
            from t3nightly.install_calibration import calibrate

            calibrate(args)
            sys.exit(0)
        if args.version == "previous":
            args.version = json.loads(
                (Path(args.state_dir).expanduser() / "last.json").read_text()
            )["previous"]
            args.allow_downgrade = True
        from t3nightly.install_policy import admit, enforce

        policy = enforce(args)
        with checked_assets(args) as assets:
            args.assets = str(assets)
            args.base_url = serve_assets(assets, args.version)
            if args.dry_run:
                from t3nightly.install_assets import check_served_assets
                from t3nightly.launcher_artifact import preflight_launcher

                if (args.hard or args.seamless) and not args.prepare_only:
                    run = Run(args)
                    preflight_launcher(run, current=run.server_version() == args.version)
                check_served_assets(args.base_url, args.version)
                print(
                    f"install: dry-run accepted {args.version}; served checksums and archive fetched and matched; no install writes"
                )
                sys.exit(0)
            run = Run(args)
            admit(run, policy)
            from t3nightly.install_resources import installer_owner

            with installer_owner(run), payload_lifecycle(run):
                if args.hard:
                    from t3nightly.install_hard import install as hard_install

                    sys.exit(hard_install(run))
                if args.seamless:
                    from t3nightly.install_hot_swap import install

                    sys.exit(install(run))
                if args.prepare_only:
                    from t3nightly.install_prepare import prepare

                    sys.exit(prepare(run))
                sys.exit(run.main())
    except (Failure, OSError, ValueError, subprocess.SubprocessError) as error:
        sys.exit(f"install refusal: {error}")
