#!/usr/bin/env python3
import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from t3nightly.rehearsal_run import Rehearsal


def main():
    parser = argparse.ArgumentParser(description="Rehearse a hard cutover in a new isolated T3 home.")
    for name in ("old-runtime", "candidate-manifest", "assets", "seed", "home", "evidence"):
        parser.add_argument(f"--{name}", type=Path, required=True)
    parser.add_argument("--label", required=True)
    parser.add_argument("--port", type=int, required=True)
    parser.add_argument("--target-host", choices=("studio", "ax42"), required=True)
    parser.add_argument("--artifact-manifest", type=Path)
    parser.add_argument("--verdict", type=Path)
    parser.add_argument("--provider", default="claudeAgent")
    parser.add_argument("--provider-binary", default=str(Path.home() / ".local/bin/claude"))
    parser.add_argument("--model", default="claude-sonnet-4-6")
    parser.add_argument("--chat-timeout", type=int, default=180)
    parser.add_argument("--health-s", type=int, default=180)
    parser.add_argument("--force-rollback", action="store_true", help="non-release proof: the candidate writes, the installer rolls back, and the old runtime reads those rows")
    parser.add_argument("--compatibility-probe", action="store_true", help="non-release evidence for migration-ineligible historical builds; never yields eligible provenance")
    args = parser.parse_args()
    return Rehearsal(args).main()


if __name__ == "__main__":
    raise SystemExit(main())
