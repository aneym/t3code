#!/usr/bin/env python3
import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from t3nightly.rehearsal_run import Rehearsal
from t3nightly.install_policy import DEFAULT_DRAIN_S


def main():
    parser = argparse.ArgumentParser(description="Rehearse a hard cutover in a new isolated T3 home.")
    for name in ("old-runtime", "candidate-manifest", "assets", "seed", "home", "evidence"):
        parser.add_argument(f"--{name}", type=Path, required=True)
    parser.add_argument("--label", required=True)
    parser.add_argument("--port", type=int, required=True)
    parser.add_argument("--target-host", choices=("studio", "ax42", "forge", "owl", "ax102"), required=True)
    parser.add_argument("--artifact-manifest", type=Path)
    parser.add_argument("--verdict", type=Path)
    parser.add_argument("--provider", default="claudeAgent")
    parser.add_argument("--provider-binary", default=str(Path.home() / ".local/bin/claude"))
    parser.add_argument("--model", default="claude-sonnet-4-6")
    parser.add_argument("--chat-timeout", type=int, default=180)
    parser.add_argument("--health-s", type=int, default=180)
    parser.add_argument("--force-rollback", action="store_true", help="non-release proof: the candidate writes, the installer rolls back, and the old runtime reads those rows")
    parser.add_argument("--compatibility-probe", action="store_true", help="non-release evidence for migration-ineligible historical builds; never yields eligible provenance")
    parser.add_argument("--hot-swap", action="store_true")
    parser.add_argument("--startup-idle-s", type=int, default=60)
    parser.add_argument("--startup-busy-ok", action="store_true", help="window flag: after --startup-idle-s, sample startup under load; old and candidate samples stay interleaved and the launcher budget still applies")
    parser.add_argument("--rpc-tree", type=Path)
    parser.add_argument("--launcher-artifact", default="")
    parser.add_argument("--old-launcher-artifact", default="")
    parser.add_argument("--connector-artifact", default="")
    parser.add_argument("--rehearsal-drain-s", type=int, choices=range(30, 301), default=DEFAULT_DRAIN_S)
    parser.add_argument("--inject", choices=("none", "warm-death", "post-flip"), default="none")
    parser.add_argument("--require-hot-swap", action="store_true")
    parser.add_argument("--strict-drain-proof", action="store_true", help="fallback proof with a Replay turn holding a strict drain refusal")
    parser.add_argument("--rollback-fallback-proof", action="store_true", help="non-release trial rollback followed by drained hard installation")
    parser.add_argument("--focused", action="store_true", help="normal capable swap and continuation/client evidence only; no launcher crash injection")
    parser.add_argument("--stock-client", action="store_true", help="keep a legacy lifecycle subscriber connected without handoff identity or confirmation")
    parser.add_argument("--queue-mode", choices=("none", "capacity", "budget"), default="none")
    parser.add_argument("--live-home", action="append", default=[])
    parser.add_argument("--offbox", default="", help="non-release proof: back the sandbox database up off-box to HOST:/path")
    parser.add_argument("--offbox-stopped-ship", action="store_true", help="with --offbox, seed from a verified replica and sync only the stopped database")
    args = parser.parse_args()
    if args.strict_drain_proof and not args.rollback_fallback_proof:
        parser.error("--strict-drain-proof requires --rollback-fallback-proof")
    if args.rollback_fallback_proof:
        if not args.hot_swap or args.inject != "none" or args.force_rollback or args.focused or args.queue_mode != "none" or args.stock_client:
            parser.error("--rollback-fallback-proof requires --hot-swap without other proof modes")
    if args.focused:
        if not args.hot_swap or args.inject != "none" or args.queue_mode != "none" or args.force_rollback:
            parser.error("--focused requires a normal --hot-swap without faults, pressure or forced rollback")
        args.require_hot_swap = True
    from t3nightly.release_eligibility import RESTORE_CLASS
    from t3nightly.release_manifest import load

    restore_class = load(args.candidate_manifest)["targets"][args.target_host]["compatibility"].get("eligibility") == RESTORE_CLASS
    if restore_class:
        if args.require_hot_swap or args.inject != "none" or args.rollback_fallback_proof or args.focused or args.queue_mode != "none" or args.stock_client:
            parser.error("restore-rollback requires drain-then-hard, not a hot-swap proof")
        args.hot_swap = False
    if args.hot_swap:
        if not args.rpc_tree:
            parser.error("--hot-swap requires --rpc-tree")
        if args.rollback_fallback_proof:
            from t3nightly.rehearsal_fallback import RollbackFallbackRehearsal

            return RollbackFallbackRehearsal(args).main()
        from t3nightly.rehearsal_hot_swap import HotSwapRehearsal

        return HotSwapRehearsal(args).main()
    return Rehearsal(args).main()


if __name__ == "__main__":
    raise SystemExit(main())
