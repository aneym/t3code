#!/usr/bin/env python3
import argparse
import json
import os
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from t3nightly.release_actions import run_fast_action
from t3nightly.release_config import FastConfig
from t3nightly.release_engine import require_engine
from t3nightly.release_graph import fast_graph
from t3nightly.release_outputs import fast_output
from t3nightly.release_targets import LINUX_TARGETS, stage_action


def main():
    parser = argparse.ArgumentParser(description="Run one fast-release graph node on this host and validate its outputs.")
    parser.add_argument("--stage", required=True)
    parser.add_argument("--host", required=True, choices=("studio", *LINUX_TARGETS))
    parser.add_argument("--version", required=True)
    parser.add_argument("--topic", required=True)
    parser.add_argument("--run", type=Path, required=True)
    parser.add_argument("--remote-run", required=True)
    parser.add_argument("--remote-tools", required=True)
    parser.add_argument("--linux-host", default="ax42")
    parser.add_argument("--base", default="")
    parser.add_argument("--override-reason", default="")
    parser.add_argument("--advisory-workers", type=int, default=4)
    parser.add_argument("--rehearsal-drain-s", type=int, choices=range(30, 61), default=45)
    parser.add_argument("--startup-busy-ok", action="store_true")
    parser.add_argument("--compact-db", action="store_true", help="window flag passed to the studio install: compact the stopped database with t3 doctor --fix")
    parser.add_argument("--defer-host", action="append", default=[], choices=tuple(LINUX_TARGETS), help="Linux host deferred for this release (repeatable); readiness skips it")
    parser.add_argument("--defer-reason", default="", help="operator decision authorizing the deferral")
    args = parser.parse_args()
    args.defer_host = tuple(dict.fromkeys(args.defer_host))
    args.defer_reason = args.defer_reason.strip()
    if bool(args.defer_host) != bool(args.defer_reason):
        parser.error("--defer-host and a nonempty --defer-reason are required together")
    try:
        fast_graph(args.linux_host, args.defer_host, args.defer_reason)
    except ValueError as error:
        parser.error(str(error))
    if args.advisory_workers < 1:
        parser.error("--advisory-workers must be positive")
    home = Path.home()
    os.environ["PATH"] = os.pathsep.join([str(home / ".local/bin"), "/opt/homebrew/bin", "/usr/local/bin", os.environ.get("PATH", "/usr/bin:/bin")])
    config = FastConfig(args.version, args.topic, args.run.resolve(), args.host, args.remote_run, args.remote_tools, args.base, linux_host=args.linux_host, override_reason=args.override_reason, advisory_workers=args.advisory_workers, rehearsal_drain_s=args.rehearsal_drain_s, startup_busy_ok=args.startup_busy_ok, defer_hosts=args.defer_host, defer_reason=args.defer_reason, compact_db=args.compact_db)
    config.run.mkdir(parents=True, exist_ok=True)
    print(json.dumps({"stage": args.stage, "host": args.host, "run": str(config.run)}), flush=True)
    try:
        if config.manifest.is_file():
            require_engine(config.manifest, config.tools)
        code = run_fast_action(args.stage, config, sys.stdout)
        sys.stdout.flush()
        if code == 0 and not fast_output(args.stage, config):
            raise ValueError("stage exited zero but its outputs are missing or invalid")
    except (OSError, ValueError, KeyError, TypeError, RuntimeError, subprocess.SubprocessError, json.JSONDecodeError) as error:
        print(json.dumps({"stage": args.stage, "error": f"{type(error).__name__}: {error}"}), flush=True)
        if stage_action(args.stage) == "install" and config.outcome().is_file():
            prior = json.loads(config.outcome().read_text())
            config.outcome().write_text(json.dumps({**prior, "outcome": "failed", "validationError": str(error), "installerOutcome": prior.get("outcome")}) + "\n")
        return 1
    return code


if __name__ == "__main__":
    raise SystemExit(main())
