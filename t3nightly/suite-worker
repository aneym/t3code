#!/usr/bin/env python3
import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from t3nightly.suite_worker import run


def main():
    parser = argparse.ArgumentParser(description="Run one advisory job in a fresh worktree on an owned host.")
    parser.add_argument("--plan", type=Path, required=True)
    parser.add_argument("--job", required=True)
    parser.add_argument("--host", required=True, choices=["ax42", "forge", "pc-wsl", "studio"])
    parser.add_argument("--out", type=Path, required=True)
    parser.add_argument("--step", action="append", help="run only this planned step; the result is explicitly partial")
    parser.add_argument("--repo")
    parser.add_argument("--worktree")
    parser.add_argument("--keep-worktree", action="store_true")
    args = parser.parse_args()
    try:
        result = run(args.plan, args.job, args.host, args.out, args.step, args.repo, args.worktree, args.keep_worktree)
    except (OSError, ValueError, RuntimeError, KeyError, TypeError, json.JSONDecodeError) as error:
        print(json.dumps({"ok": False, "error": str(error)}), file=sys.stderr)
        return 2
    print(json.dumps(result, indent=2, sort_keys=True))
    return {"pass": 0, "fail": 1, "unavailable": 3}[result["result"]]


if __name__ == "__main__":
    raise SystemExit(main())
