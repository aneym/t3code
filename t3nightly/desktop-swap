#!/usr/bin/env python3
import argparse
import os
import plistlib
import shutil
import subprocess
import sys
import tempfile
from datetime import datetime, timezone
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from t3nightly.release_approval import require_approval, verdict_path
from t3nightly.release_signatures import verify_desktop


def main():
    parser = argparse.ArgumentParser(description="Install an approved, signed and notarized nightly desktop without quitting or opening it.")
    parser.add_argument("zip", type=Path)
    parser.add_argument("--verdict", type=Path)
    parser.add_argument("--dry-run", action="store_true")
    args = parser.parse_args()
    dest = Path("/Applications/T3 Dev.app")
    try:
        with tempfile.TemporaryDirectory(prefix="t3nightly-desktop-") as raw:
            work = Path(raw)
            subprocess.run(["ditto", "-x", "-k", str(args.zip), raw], check=True, timeout=240)
            new = work / dest.name
            with (new / "Contents/Info.plist").open("rb") as handle:
                version = plistlib.load(handle)["CFBundleShortVersionString"]
            require_approval(version, verdict_path(version, args.verdict), args.zip.parent.parent / "shots")
            verify_desktop(new)
            if args.dry_run:
                print(f"desktop-swap: accepted {version}; no app writes")
                return
            backups = Path.home() / "Applications-backup"
            backups.mkdir(exist_ok=True)
            backup = backups / f"T3 Dev {datetime.now(timezone.utc):%Y%m%dT%H%M%S%fZ}.app"
            with tempfile.TemporaryDirectory(prefix=".t3nightly-", dir=dest.parent) as staging:
                staged = Path(staging) / dest.name
                subprocess.run(["ditto", str(new), str(staged)], check=True, timeout=240)
                verify_desktop(staged)
                if dest.exists():
                    os.replace(dest, backup)
                try:
                    os.replace(staged, dest)
                except OSError:
                    if backup.exists():
                        os.replace(backup, dest)
                    raise
            cutoff = datetime.now(timezone.utc).timestamp() - 14 * 86400
            for old in backups.glob("T3 Dev *.app"):
                if old != backup and old.is_dir() and not old.is_symlink() and old.stat().st_mtime < cutoff:
                    shutil.rmtree(old)
            print(f"installed desktop {version}; quit and reopen the app yourself to load it")
    except (OSError, ValueError, KeyError, subprocess.SubprocessError) as error:
        parser.exit(1, f"desktop-swap refusal: {error}\n")


if __name__ == "__main__":
    main()
