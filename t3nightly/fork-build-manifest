#!/usr/bin/env python3
import json
import subprocess
import sys
from datetime import datetime, timezone

version = sys.argv[1]
tag = f"v{version.split('.aneym.')[0]}"
log = subprocess.run(
    ["git", "log", "--topo-order", "--merges", "--format=%s%x09%P", f"{tag}..HEAD"],
    capture_output=True, text=True, check=True,
).stdout
topics = []
seen = set()
for line in log.splitlines():
    subject, parents = line.split("\t")
    branch = next((word.strip("'\"") for word in subject.split() if word.strip("'\"").startswith(("aneym/", "origin/aneym/"))), None)
    if not branch:
        continue
    branch = branch.removeprefix("origin/")
    if branch.startswith(("aneym/nightly", "aneym/mobile-candidate")) or branch in seen:
        continue
    seen.add(branch)
    topics.append({"branch": branch, "sha": parents.split()[1][:10]})
print(json.dumps({"version": version, "upstreamTag": tag, "builtAt": datetime.now(timezone.utc).isoformat(), "topics": list(reversed(topics))}))
